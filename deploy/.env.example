# deploy/.env — настройки и секреты продакшена qmmq.kz.
#
# Файл живёт ТОЛЬКО на сервере: /opt/qmmq/deploy/.env (права 600) — в git его нет.
# При первом деплое scripts/release.sh создаёт его из этого шаблона и сам генерирует
# PAYLOAD_SECRET, POSTGRES_PASSWORD и DATABASE_URL. Остальное заполните вручную.
# Сохраните копию файла в менеджере паролей: без PAYLOAD_SECRET и пароля базы
# восстановление на новом сервере сложнее.
#
# Формат: КЛЮЧ=значение, без кавычек и пробелов вокруг «=». Не используйте символ $
# (Docker Compose подставляет переменные) — генерируйте секреты через openssl rand -hex.
# После изменения файла: cd /opt/qmmq/deploy && docker compose up -d

# ---------- Приложение (docs/ARCHITECTURE.md → «Переменные окружения») ----------

# Абсолютные ссылки, URL вебхука amoCRM.
SITE_URL=https://qmmq.kz
# Хост, на котором «/» отдаёт активный лендинг.
LANDING_HOST=contest.qmmq.kz
# Вход в админку действует на всех поддоменах (аналитика не считает сотрудников)
COOKIE_DOMAIN=.qmmq.kz
# Подпись сессий Payload: openssl rand -hex 32 (генерируется автоматически).
PAYLOAD_SECRET=
# PostgreSQL внутри docker compose: хост db, порт 5432. Пароль = POSTGRES_PASSWORD.
DATABASE_URL=postgres://qmmq:CHANGE_ME@db:5432/qmmq

# ---------- PostgreSQL ----------

POSTGRES_DB=qmmq
POSTGRES_USER=qmmq
# openssl rand -hex 24 (генерируется автоматически).
POSTGRES_PASSWORD=

# ---------- HTTPS (Caddy + Let's Encrypt) ----------

# Основной домен; www.<домен> перенаправляется на него.
SITE_DOMAIN=qmmq.kz
# Почта для Let's Encrypt (обязательно, реальный адрес администратора).
ACME_EMAIL=

# ---------- Бэкапы в Yandex Object Storage (регион Казахстан) ----------

# Имя бакета и статический ключ сервисного аккаунта qmmq-backup (роль storage.uploader на бакет).
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.kz
BACKUP_S3_REGION=kz1
# Папка в бакете; на неё настроено правило жизненного цикла «удалять через 30 дней».
BACKUP_S3_PREFIX=daily
# Сколько последних копий держать ещё и на диске сервера (/var/backups/qmmq).
BACKUP_KEEP_LOCAL=2
# Необязательно: URL, который дёргается после успешного бэкапа (например, healthchecks.io),
# чтобы получить письмо, если бэкап не пришёл.
BACKUP_PING_URL=

# ---------- Сборка ----------

# Потолок памяти Node (МБ) для next build. При 8 ГБ ОЗУ можно поднять до 6144.
NODE_BUILD_HEAP_MB=3072
